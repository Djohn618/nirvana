<h1>User management</h1>
<p class="subtitle">Manage all users of the application.</p>

<table>
  <thead>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th>Registered</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td>
          <span class="badge <%= user.admin? ? 'badge-gold' : 'badge-neutral' %>">
            <%= user.role.capitalize %>
          </span>
        </td>
        <td><%= user.created_at.strftime("%d.%m.%Y") %></td>
        <td>
          <%= link_to "Edit", edit_admin_user_path(user), class: "btn secondary small" %>
          <% if user != current_user %>
            <%= button_to "Delete", admin_user_path(user), method: :delete,
                class: "danger small",
                data: { confirm: "Permanently delete user '#{user.username}' and all their data? This cannot be undone." } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>