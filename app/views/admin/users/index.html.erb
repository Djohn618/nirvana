<h1>User management (Admin)</h1>

<table border="1" cellpadding="8">
  <thead>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th>Registered</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td><%= user.created_at.strftime("%d.%m.%Y") %></td>
        <td>
          <%= link_to "Edit", edit_admin_user_path(user) %>
          <% if user != current_user %>
            | <%= button_to "Delete", admin_user_path(user), method: :delete,
                data: { confirm: "Really delete?" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>