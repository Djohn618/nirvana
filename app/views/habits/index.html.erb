<h1>My Habits</h1>
<p class="subtitle">Track your daily disciplines.</p>

<p>
  <%= link_to "Create new habit", new_habit_path, class: "btn" %>
  <%= link_to "Check-in today", new_habit_log_path, class: "btn secondary" %>
</p>

<% if @habits.any? %>
  <% @habits.each do |habit| %>
    <div class="habit-card">
      <div class="habit-info">
        <div class="habit-name"><%= habit.name %></div>
        <div class="habit-meta">Created <%= habit.created_at.strftime("%d.%m.%Y") %></div>
      </div>
      <div class="streak">
        <div class="streak-number"><%= @streaks[habit.id] %></div>
        <div class="streak-label">Day Streak</div>
      </div>
      <div>
        <%= button_to "Delete", habit_path(habit), method: :delete,
            class: "danger small" %>
      </div>
    </div>
  <% end %>

  <h2>Last 7 days</h2>
  <div class="card">
    <div class="streak-grid">
      <% @habits.each do |habit| %>
        <div class="streak-grid-row">
          <div class="streak-grid-name"><%= habit.name %></div>
          <div class="streak-grid-dots">
            <% 6.downto(0) do |i| %>
              <% date = Date.today - i %>
              <% log = habit.habit_logs.find_by(user: current_user, date: date) %>
              <div class="streak-dot <%= log&.completed ? 'done' : 'missed' %>" title="<%= date.strftime('%d.%m.%Y') %>"></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="card text-center">
    <p>You don't have any habits yet. Create your first one to get started!</p>
  </div>
<% end %>