<h1>New habit</h1>

<%= form_with model: @habit do |f| %>
  <% if @habit.errors.any? %>
    <div style="color: red;">
      <ul>
        <% @habit.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Habit name (e.g. Workout, Meditation, Reading)" %><br>
    <%= f.text_field :name, required: true, placeholder: "e.g. Workout" %>
  </div>

  <div>
  <%= f.submit "Create" %>
  <%= link_to "Cancel", habits_path, class: "btn secondary" %>
</div>

<%= link_to "Back", habits_path %>