<p>
  <%= link_to "← Back to groups", groups_path, class: "text-muted" %>
</p>

<h1><%= @group.name %></h1>
<p class="subtitle"><%= @group.description %></p>
<p class="text-small text-muted">Created by: <%= @group.creator.username %></p>

<% unless @is_member %>
  <p>
    <%= button_to "Join group", group_memberships_path(@group), method: :post %>
  </p>
<% end %>

<h2>Members (<%= @memberships.count %>)</h2>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Role</th>
      <th>Today</th>
      <% if @is_leader %>
        <th>Action</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @memberships.each do |membership| %>
      <tr>
        <td><%= membership.user.username %></td>
        <td>
          <span class="badge <%= membership.role == 'leader' ? 'badge-gold' : 'badge-neutral' %>">
            <%= membership.role.capitalize %>
          </span>
        </td>
        <td>
          <% stats = @member_stats[membership.user_id] %>
          <% if stats && stats[:total] > 0 %>
            <%= stats[:done] %>/<%= stats[:total] %> done
          <% else %>
            <span class="text-muted">No habits</span>
          <% end %>
        </td>
        <% if @is_leader %>
          <td>
            <% if membership.user != current_user %>
              <%= button_to "Remove", group_membership_path(@group, membership), method: :delete,
                  class: "danger small",
                  onclick: "return confirm('Remove #{membership.user.username} from this group? They will lose access.')" %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @is_member && !@is_leader %>
  <p class="mt-4">
    <% my_membership = @group.memberships.find_by(user: current_user) %>
    <%= button_to "Leave group", group_membership_path(@group, my_membership), method: :delete,
        class: "danger",
        onclick: "return confirm('Leave this group? You will need to be added back if you want to rejoin.')" %>
  </p>
<% end %>

<% if @group.creator == current_user || current_user.admin? %>
  <p class="mt-4">
    <%= button_to "Delete group", group_path(@group), method: :delete,
        class: "danger",
        onclick: "return confirm('Permanently delete group \\'#{@group.name}\\' and remove all members? This cannot be undone.')" %>
  </p>
<% end %>