<h1><%= @group.name %></h1>
<p><%= @group.description %></p>
<p><small>Created by: <%= @group.creator.username %></small></p>

<% unless @is_member %>
  <%= button_to "Join group", group_memberships_path(@group), method: :post %>
<% end %>

<h2>Members (<%= @memberships.count %>)</h2>
<table border="1" cellpadding="8">
  <thead>
    <tr>
      <th>Name</th>
      <th>Role</th>
      <th>Today</th>
      <% if @is_leader %>
        <th>Action</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @memberships.each do |membership| %>
      <tr>
        <td><%= membership.user.username %></td>
        <td><%= membership.role %></td>
        <td>
          <% stats = @member_stats[membership.user_id] %>
          <% if stats && stats[:total] > 0 %>
            <%= stats[:done] %>/<%= stats[:total] %> done
            <%= stats[:done] == stats[:total] ? "🔥" : "" %>
          <% else %>
            No habits
          <% end %>
        </td>
        <% if @is_leader && membership.user != current_user %>
          <td>
            <%= button_to "Remove", group_membership_path(@group, membership), method: :delete %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @is_member && !@is_leader %>
  <p>
    <% my_membership = @group.memberships.find_by(user: current_user) %>
    <%= button_to "Leave group", group_membership_path(@group, my_membership), method: :delete %>
  </p>
<% end %>

<% if @group.creator == current_user || current_user.admin? %>
  <p>
    <%= button_to "Delete group", @group, method: :delete,
        data: { confirm: "Really delete?" } %>
  </p>
<% end %>