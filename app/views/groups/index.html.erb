<h1>Groups</h1>

<%= link_to "Create new group", new_group_path %>

<h2>My groups</h2>
<% if @my_groups.any? %>
  <% @my_groups.each do |group| %>
    <div style="border: 1px solid #ccc; padding: 10px; margin: 10px 0;">
      <h3><%= link_to group.name, group %></h3>
      <p><%= group.description %></p>
      <p><small><%= group.members.count %> members</small></p>
    </div>
  <% end %>
<% else %>
  <p>You're not in any group yet.</p>
<% end %>

<h2>Other groups</h2>
<% @other_groups.each do |group| %>
  <div style="border: 1px solid #eee; padding: 10px; margin: 10px 0;">
    <h3><%= link_to group.name, group %></h3>
    <p><%= group.description %></p>
  </div>
<% end %>