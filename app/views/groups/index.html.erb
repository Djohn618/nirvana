<h1>Groups</h1>
<p class="subtitle">Your accountability circles.</p>

<p>
  <%= link_to "Create new group", new_group_path, class: "btn" %>
</p>

<h2>My groups</h2>
<% if @my_groups.any? %>
  <% @my_groups.each do |group| %>
    <%= link_to group, class: "group-card" do %>
      <div class="group-card-header">
        <h3 class="group-card-title"><%= group.name %></h3>
        <span class="group-card-members"><%= group.members.count %> members</span>
      </div>
      <p class="group-card-desc"><%= group.description %></p>
    <% end %>
  <% end %>
<% else %>
  <div class="card text-center">
    <p>You're not in any group yet.</p>
  </div>
<% end %>

<h2>Other groups</h2>
<% if @other_groups.any? %>
  <% @other_groups.each do |group| %>
    <%= link_to group, class: "group-card group-card-muted" do %>
      <div class="group-card-header">
        <h3 class="group-card-title"><%= group.name %></h3>
        <span class="group-card-members"><%= group.members.count %> members</span>
      </div>
      <p class="group-card-desc"><%= group.description %></p>
    <% end %>
  <% end %>
<% else %>
  <div class="card text-center">
    <p>No other groups available.</p>
  </div>
<% end %>