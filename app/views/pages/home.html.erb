<% if logged_in? %>
  <div class="hero">
    <h1>Welcome back, <%= current_user.username %></h1>
    <p class="subtitle">Every day is a step forward. Keep going.</p>

    <div class="hero-actions">
      <%= link_to new_habit_log_path, class: "btn" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:18px;height:18px"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        Check-in for today
      <% end %>
      <%= link_to "View my habits", habits_path, class: "btn secondary" %>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-number"><%= current_user.habits.count %></div>
      <div class="stat-label">Habits</div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= current_user.habit_logs.where(date: Date.today, completed: true).count %></div>
      <div class="stat-label">Done today</div>
    </div>
    <div class="stat-card">
      <div class="stat-number"><%= current_user.groups.count %></div>
      <div class="stat-label">Groups</div>
    </div>
  </div>

  <div class="quote">
    "You do not rise to the level of your goals. You fall to the level of your systems."
  </div>
<% else %>
  <div class="hero">
    <h1>Nirvana</h1>
    <p class="subtitle">Your comeback tracker for discipline & inner peace.</p>

    <div class="hero-actions">
      <%= link_to "Sign up", new_registration_path, class: "btn" %>
      <%= link_to "Log in", new_session_path, class: "btn secondary" %>
    </div>
  </div>
<% end %>