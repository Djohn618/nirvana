<h1>Daily check-in</h1>
<p class="subtitle">What did you get done today?</p>

<% if @habits.any? %>
  <% @habits.each do |habit| %>
    <% log = @today_logs.find { |l| l.habit_id == habit.id } %>
    <div class="checkin-card <%= log&.completed ? 'done' : '' %>">
      <div class="checkin-name"><%= habit.name %></div>
      <div>
        <%= button_to (log&.completed ? "Undo" : "Mark done"),
            habit_logs_path(habit_id: habit.id), method: :post,
            class: (log&.completed ? "secondary small" : "small") %>
      </div>
    </div>
  <% end %>

  <p class="text-center mt-4">
    <%= link_to "View my streaks →", habits_path %>
  </p>
<% else %>
  <div class="card text-center">
    <p>You don't have any habits yet.
       <%= link_to "Create your first one!", new_habit_path %></p>
  </div>
<% end %>